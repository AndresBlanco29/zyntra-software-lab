# Copia a .env:  copy .env.example .env

# Edita los valores con los mismos datos que usas en MySQL Workbench.



DEBUG=True



# --- MySQL local (Workbench) ---

# En Workbench: conexión → Host, Port, Username

# El nombre de la base (Schema) va en MYSQLDATABASE

MYSQLHOST=127.0.0.1

MYSQLPORT=3306

MYSQLUSER=root

MYSQLPASSWORD=tu_contraseña_aqui

MYSQLDATABASE=nombre_de_tu_base



# Alias alternativos (opcional, mismos valores):

# DB_HOST=127.0.0.1

# DB_PORT=3306

# DB_USER=root

# DB_PASSWORD=

# DB_NAME=nombre_de_tu_base



# Si no defines MYSQL* (o falta MYSQLPASSWORD), Django usa SQLite en config/db.sqlite3



# --- Railway / producción (solo si sincronizas con la nube) ---

# SECRET_KEY=

# ALLOWED_HOSTS=



# --- QuickBooks (Intuit Developer) ---

# 1. Entra a https://developer.intuit.com/ → tu app → Keys & OAuth

# 2. Copia Client ID y Client Secret (usa Sandbox para pruebas)

# 3. En Redirect URIs agrega EXACTAMENTE la misma URL que QUICKBOOKS_REDIRECT_URI

# 4. Guarda este archivo como .env, pega los valores, reinicia: python manage.py runserver

QUICKBOOKS_CLIENT_ID=tu_client_id_aqui

QUICKBOOKS_CLIENT_SECRET=tu_client_secret_aqui

QUICKBOOKS_REDIRECT_URI=http://127.0.0.1:8000/quickbooks/callback/

QUICKBOOKS_ENVIRONMENT=sandbox
# Solo catálogo en QuickBooks Center (True hasta activar contabilidad completa)
QUICKBOOKS_CATALOG_ONLY_MODE=True
# QUICKBOOKS_SCOPES=com.intuit.quickbooks.accounting

# --- AI Assistant (OpenAI; configure these only in Railway/.env) ---
# Keep the key server-side. Never expose it in browser JavaScript.
OPENAI_API_KEY=
AI_ASSISTANT_ENABLED=False
AI_ASSISTANT_CHAT_MODEL=gpt-4.1-mini
AI_ASSISTANT_EMBEDDING_MODEL=text-embedding-3-small
AI_ASSISTANT_OPENAI_TIMEOUT_SECONDS=25
AI_ASSISTANT_MAX_MESSAGES_PER_HOUR=30
AI_ASSISTANT_MAX_MESSAGE_CHARS=2000
# Percentage of visitors that can see the enabled assistant.
AI_ASSISTANT_ROLLOUT_PERCENT=100

# Railway Redis/Celery (worker service)
# REDIS_URL=redis://default:password@host:port
# CELERY_TASK_ALWAYS_EAGER=False

