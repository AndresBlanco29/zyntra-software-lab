# Railway start commands for the DEMO project only.
# Do NOT use this Procfile for La Tortilla Grocery production.
# No production QuickBooks scheduler. No LTG ensure_superuser / AI knowledge seed.

web: python manage.py migrate --noinput && python manage.py check_demo_isolation --require-demo && python manage.py collectstatic --noinput && gunicorn config.config.wsgi:application --bind 0.0.0.0:$PORT --timeout 600 --graceful-timeout 120
worker: celery -A config.config worker --loglevel=INFO --concurrency=1
beat: celery -A config.config beat --loglevel=INFO
