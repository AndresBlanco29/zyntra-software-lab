# =============================================================================
# DEMO / SOFTWARE LAB — copy to a DEMO-only .env (never reuse LTG production .env)
# =============================================================================

DEMO_MODE=1
SHOWCASE_MODE=1
DEMO_ENVIRONMENT_LABEL=SOFTWARE LAB
DEMO_BRAND_NAME=Zyntra
DEMO_BRAND_LEGAL_NAME=Zyntra
DEMO_BRAND_TAGLINE=B2B distribution operations platform
DEMO_DISABLE_OUTBOUND_EMAIL=1
DEMO_ALLOW_CLOUDINARY=0

DEBUG=True
SECRET_KEY=replace-with-a-unique-demo-secret-key

# Local: force SQLite (config/db_demo.sqlite3) even if MySQL vars exist in another .env
DEMO_USE_SQLITE=1

# Dedicated MySQL only when DEMO_USE_SQLITE=0 (never reuse LTG production schema).
# MYSQLHOST=127.0.0.1
# MYSQLPORT=3306
# MYSQLUSER=demo_user
# MYSQLPASSWORD=replace_me
# MYSQLDATABASE=demo_b2b_db

ALLOWED_HOSTS=127.0.0.1,localhost
# DEMO_CANONICAL_DOMAIN=demo.your-corp-domain.com
# DEMO_RAILWAY_DOMAIN=your-demo-service.up.railway.app
# CSRF_TRUSTED_ORIGINS=https://demo.your-corp-domain.com
# APP_BASE_URL=https://demo.your-corp-domain.com

CORS_ALLOW_ALL_ORIGINS=0
USE_CLOUDINARY_MEDIA=0
# Zyntra Guide — demo-only mock (no OpenAI). Never set PROVIDER=live here.
AI_ASSISTANT_ENABLED=1
AI_ASSISTANT_PROVIDER=mock

# Showcase: mock only (no Intuit network calls until Fase 9/10 wiring)
QUICKBOOKS_PROVIDER=mock
QUICKBOOKS_ENVIRONMENT=sandbox
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=http://127.0.0.1:8000/quickbooks/callback/
QUICKBOOKS_CATALOG_ONLY_MODE=1
QUICKBOOKS_IMPORT_ACCOUNTING_DOCUMENTS=0

DEFAULT_FROM_EMAIL=Demo Software Lab <noreply@example.com>
ORDER_NOTIFICATION_EMAILS=demo-orders@example.com
ORDERS_NOTIFICATION_EMAIL=demo-orders@example.com

# Do not set LTG Resend / Cloudinary / OpenAI / Twilio keys here.
# RESEND_API_KEY=
# OPENAI_API_KEY=
# REDIS_URL=
CELERY_TASK_ALWAYS_EAGER=1

# After migrate on an empty DEMO database:
#   python manage.py seed_demo_showcase --reset
# Login: demo@demo-system.com / DemoShowcase2026!
